Subject: Honour `nosan` in DEB_BUILD_OPTIONS to skip building libsanitizer.

Upstream rules.defs disables `with_libasan/lsan/tsan/ubsan/hwasan` for
`DEB_STAGE=rtlibs` but leaves `with_asan` etc. set to yes — which means
configure still gets `--enable-libsanitizer` and the build compiles the
entire libsanitizer subtree before discarding it at packaging time. Add a
DEB_BUILD_OPTIONS=nosan toggle that clears the underlying flags, so
`rules2:411` adds `--disable-libsanitizer` and the libsanitizer build is
skipped entirely. Cuts gcc-16 build time roughly in half on arm64/rtlibs.

--- a/debian/rules.defs
+++ b/debian/rules.defs
@@ -1569,6 +1569,14 @@ ifneq (,$(filter $(DEB_TARGET_ARCH),$(ubsan_archs)))
   with_ubsan := yes
 endif

+  ifneq (,$(findstring nosan, $(DEB_BUILD_OPTIONS)))
+    with_asan :=
+    with_lsan :=
+    with_tsan :=
+    with_ubsan :=
+    with_hwasan :=
+  endif
+
 endif # with_cdev

